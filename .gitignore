# ========================================================
# Gahbaz Platform Root GitIgnore
# ========================================================

# Dependencies
node_modules/
.pnpm-store/
package-lock.json
yarn.lock

# Build & Reproducible Outputs
dist/
build/
client/dist/
backend/dist/

# Environment Variables & Secrets (Keep .env.example / .env.sample templates only)
.env
.env.*
!.env.example
!.env.sample
client/.env
client/.env.*
!client/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Uploads & Media Storage
uploads/
backend/uploads/
server-uploads/

# Testing & Coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches, Temporary & Editor Metadata
.eslintcache
.cache/
.vite/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.tmp
*.temp
scratch/
analyze_arabic.js