{
  "name": "elearning-system",
  "version": "1.0.0",
  "description": "An E-learning system connects universities, teachers, and students. It helps students easily access their course data and facilitates communication between students and teachers.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "setup-project": "npm i && cd client && npm i",
    "setup-production-app": "npm i && cd client && npm i --legacy-peer-deps && npm run build ",
    "server": "tsx watch src/server.ts",
    "client": "cd ../client && npm start",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "seed": "tsx src/seeds/seedFullDemoData.ts",
    "seed:prod": "node dist/seeds/seedFullDemoData.js",
    "create-super-admin": "tsx src/scripts/createSuperAdmin.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/O2sa/Gahbaz.git"
  },
  "keywords": [
    "gahbaz",
    "elearning-system",
    "academic-management",
    "university",
    "courses",
    "student"
  ],
  "author": "Osama Mabkhout",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/O2sa/Gahbaz/issues"
  },
  "homepage": "https://github.com/O2sa/Gahbaz#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "16.4.4",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-os-utils": "^1.3.7",
    "nodemailer": "^6.9.13",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.11.9",
    "nodemon": "^3.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^2.1.2"
  }
}