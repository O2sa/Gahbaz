{
  "name": "elearning-system",
  "version": "1.0.0",
  "description": "An E-learning system connects universities, teachers, and students. It helps students easily access their course data and facilitates communication between students and teachers.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "setup-project": "npm i && cd client && npm i",
    "setup-production-app": "npm i && cd client && npm i --legacy-peer-deps && npm run build ",
    "server": "nodemon server",
    "client": "cd ../client && npm start",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "seed": "node src/seeds/seedFullDemoData.js",
    "create-super-admin": "node src/scripts/createSuperAdmin.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/CS0Team/elearning-system-api.git"
  },
  "keywords": [
    "elearning-system",
    "online-course",
    "courses",
    "student",
    "universties"
  ],
  "author": "Osama Mabkhout",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CS0Team/elearning-system-api/issues"
  },
  "homepage": "https://github.com/CS0Team/elearning-system-api#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "16.4.4",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-os-utils": "^1.3.7",
    "nodemailer": "^6.9.13",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.2"
  }
}