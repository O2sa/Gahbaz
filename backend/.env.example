# ==========================================
# Gahbaz Backend Environment Variables (Render)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas or Render Managed MongoDB)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gahbaz?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_strong_production_jwt_secret_key_here
JWT_LIFETIME=1d

# Allowed Frontend URL (Netlify Production and Deploy Previews)
CLIENT_URL=https://gahbaz.netlify.app

# Public Base URL of this backend API
PUBLIC_URL=https://gahbaz-backend.onrender.com

# Media Storage Provider (local, s3, wasabi, or cloudinary)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Optional: Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: AWS S3 Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Optional: Wasabi Cloud Storage Credentials
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_REGION=us-east-1
WASABI_BUCKET_NAME=
WASABI_ENDPOINT=https://s3.wasabisys.com

# Optional: SMTP Mailer Configuration
EMAIL_USER=
