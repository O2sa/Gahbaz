# ========================================================
# Gahbaz Frontend Environment Configuration
# ========================================================

# Backend API Base URL (e.g., http://localhost:5000 or https://api.yourdomain.com)
# When set, the frontend in production makes all API calls directly to this server.
VITE_API_URL=http://localhost:5000

# Backend Root Host
VITE_BACKEND_URL=http://localhost:5000

# WebSocket / Socket.IO Server URL
VITE_SOCKET_URL=http://localhost:5000
