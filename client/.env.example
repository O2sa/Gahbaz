# ==========================================
# Gahbaz Frontend Environment Variables (Netlify)
# ==========================================

# Production Backend API URL (Render Web Service)
# Points to the root API endpoint (e.g., https://gahbaz-api.onrender.com/api/v1)
VITE_API_URL=https://gahbaz-api.onrender.com/api/v1

# Real-Time WebSocket Server (Socket.IO)
# Points to the base server origin (e.g., https://gahbaz-api.onrender.com)
VITE_SOCKET_URL=https://gahbaz-api.onrender.com

# Optional: Google Analytics Measurement ID
VITE_GA_MEASUREMENT_ID=G-P7SYZGRE0X
